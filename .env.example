# ─── Copie ce fichier en .env.local (en local) et ajoute les mêmes variables dans Netlify > Site settings > Environment variables ───

# URL publique du site (sert pour les métadonnées et les aperçus de partage)
NEXT_PUBLIC_SITE_URL=https://jemimasportfolio.netlify.app

# Gemini (clé gratuite à créer sur https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# MySQL (en local : XAMPP ; en ligne : TiDB Cloud Starter, compatible MySQL)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=ma_jemima
# Mettre "true" pour TiDB Cloud (connexion chiffrée obligatoire)
DATABASE_SSL=false

# Espace admin
ADMIN_EMAIL=jemimaoceanenguessan@gmail.com
# Généré avec : npm run hash-password -- "ton-mot-de-passe"
ADMIN_PASSWORD_HASH=
# Une longue chaîne aléatoire (au moins 32 caractères)
ADMIN_SESSION_SECRET=
# Optionnel, pour la double authentification : npm run totp-secret
ADMIN_TOTP_SECRET=

# Optionnel : envoi d'un e-mail à chaque message de contact (https://resend.com, offre gratuite)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=jemimaoceanenguessan@gmail.com
